# Backend dos testes de ponta a ponta (compose desta pasta). Dados e chaves
# falsos: nada aqui vale fora dos testes. No modo sem Docker, o
# playwright.config.js lê este arquivo e troca os endereços por localhost.

# Ambiente e2e: sem limite de requisições e com o Mercado Pago falso
NODE_ENV=e2e
SECRET_KEY=e2e-secret-key-only-for-tests-with-32-chars
LOG_FORMAT=json
COOKIE_SECURE=false

DB_USER=librishelf
DB_PASSWORD=librishelf
DB_HOST=db
DB_PORT=5432
DB_NAME=librishelf_e2e

# Endereço que o navegador usa (links dos e-mails e volta do checkout). O
# navegador manda Origin nos POST mesmo no mesmo domínio: entra no CORS.
APP_URL=http://localhost:8090
ALLOWED_ORIGINS=http://localhost:8090

# Caixa de e-mail falsa (e2e/fakes/mail.js)
SMTP_HOST=fakes
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Librishelf <noreply@librishelf.test>
# O banco do e2e não é limpo entre execuções: o limite da caixa (100/dia)
# seguraria os e-mails da fila na segunda rodada
MAIL_DAILY_LIMIT=1000000

# Mercado Pago falso (e2e/fakes/mercadoPago.js). MP_API_URL só vale com NODE_ENV=e2e.
MP_ACCESS_TOKEN=TEST-e2e-access-token
MP_WEBHOOK_SECRET=e2e-webhook-secret
MP_API_URL=http://fakes:4010
MP_NOTIFICATION_URL=http://backend:3050/webhooks/mercadopago

# Fila: os testes não esperam o intervalo de produção
JOB_POLL_MS=300
