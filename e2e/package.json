{
  "name": "librishelf-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Testes de ponta a ponta do Librishelf (Playwright)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down -v",
    "test:stack": "cross-env E2E_BASE_URL=http://localhost:8090 E2E_FAKES_URL=http://localhost:4010 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "cross-env": "^10.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
