{
  "name": "librishelf-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "node --env-file=./src/.env --watch src/server.js",
    "start": "node src/server.js",
    "email:preview": "node src/scripts/previewEmails.js",
    "db:migrate": "node --env-file=./src/.env src/database/migrate.js",
    "db:migrate:test": "node --env-file=./src/.env.test src/database/migrate.js",
    "db:migrate:docker": "node src/database/migrate.js",
    "db:migrate:local": "node --env-file=./src/.env.local src/database/migrate.js",
    "db:seed": "node --env-file=./src/.env.local src/scripts/seed.js",
    "server:local": "node --env-file=./src/.env.local --watch src/server.js",
    "enrich:isbn": "node --env-file=./src/.env src/scripts/enrichIsbn.js",
    "enrich:isbn:docker": "node src/scripts/enrichIsbn.js",
    "test": "cross-env NODE_ENV=test node --env-file=./src/.env.test --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "cross-env NODE_ENV=test SECRET_KEY=unit-test-secret-key-with-32-chars-min node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand src/tests/unit src/tests/integration/cors.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.16.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
