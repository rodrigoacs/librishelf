# --- Banco ---
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=5432
# SSL do Postgres (deixe false se o banco está na mesma rede Docker)
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=/caminho/para/ca.pem

# --- Auth ---
# Mínimo de 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=
# Vazio = segue o ambiente (true quando NODE_ENV=production, como na imagem Docker)
COOKIE_SECURE=

# --- HTTP ---
PORT=3050
# Origens que podem chamar a API de outro domínio (CORS). Em produção o frontend
# fala com a API pelo mesmo domínio (/api), então isto só importa no dev.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Quantidade de proxies na frente do app. No docker-compose já vem 2
# (nginx da VPS → nginx do container do frontend). Vazio sem proxy.
TRUST_PROXY=

# --- Uploads ---
# Padrão: ./uploads relativo ao diretório de execução
# UPLOAD_DIR=

# --- Busca por ISBN (Open Library) ---
# E-mail de contato enviado no User-Agent (pedido pelo Open Library). Com ele o
# limite é de 3 requisições/s; sem ele, 1/s.
OPENLIBRARY_CONTACT=

# --- E-mail (recuperar senha e confirmar cadastro) ---
# Endereço público do app; os links dos e-mails apontam para cá.
APP_URL=https://librishelf.com
# Servidor SMTP. 587 + SMTP_SECURE=false (STARTTLS) ou 465 + SMTP_SECURE=true.
# Vazio: os e-mails não saem; o conteúdo vai para o log (útil no desenvolvimento).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Librishelf <noreply@librishelf.com>"
# Avisos de seguidores (opt-in na Conta): no máximo um e-mail a cada N horas
# por pessoa; o que acontecer no meio-tempo vai junto. Opcional (padrão 6).
# FOLLOW_EMAIL_INTERVAL_HOURS=6
