# --- Banco ---
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=5432
# SSL do Postgres (deixe false se o banco está na mesma rede Docker)
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=/caminho/para/ca.pem

# --- Auth ---
# Mínimo de 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=
# Vazio = segue o ambiente (true quando NODE_ENV=production, como na imagem Docker)
COOKIE_SECURE=

# --- HTTP ---
PORT=3050
# Origens que podem chamar a API de outro domínio (CORS). Em produção o frontend
# fala com a API pelo mesmo domínio (/api), então isto só importa no dev.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Quantidade de proxies na frente do app. No docker-compose já vem 2
# (nginx da VPS → nginx do container do frontend). Vazio sem proxy.
TRUST_PROXY=

# --- Uploads ---
# Padrão: ./uploads relativo ao diretório de execução
# UPLOAD_DIR=
